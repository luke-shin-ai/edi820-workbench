node_modules/
dist/
out/*
!out/.gitkeep
# The hook log is the evidence that the hooks fire; it holds no personal data, so it is
# committed rather than quoted. Everything else under out/ is a run artefact.
!out/hook-log.txt
# The one committed report: the AgentStop hook re-derives it on any clone, so the
# "same inputs, same verdict" claim has something to check out of the box.
!out/evidence/
out/evidence/*
!out/evidence/report.json
.DS_Store
*.log

# Kiroween 2026 submission requirement: /.kiro MUST be committed.
# Never add .kiro, .kiro/specs, .kiro/steering or .kiro/hooks to this file.

# Working copy only: local notes, drafts, run logs and review scratch. The patterns are
# general on purpose, so this file describes a kind of file rather than listing the ones
# that happen to be here today. Nothing in this section is part of the submission.
/*.md
!README.md
!EVIDENCE.md
!review.md
!devpost-submission-draft.md
*-draft.md
logs/
screenshots/
reviews*/
*-review.md
*-review-v*.md

# Kiro's task-graph state: session ids and timestamps for the task tool, not part of the spec.
.kiro/specs/**/tasks.meta.json

# local scratch (tool runs, temporary reports)
.tmp/

# The video ships through the submission's YouTube link; the encoded file and the
# render intermediates stay out of the repository (they are reproducible with
# demo-video/build/README.md and are 100+ MB).
demo-video/*.mp4
demo-video/screenshots/
demo-video/build/plates/
demo-video/build/segs/
demo-video/build/tts/
demo-video/build/*.wav
demo-video/build/*.ass
demo-video/build/video_only.mp4

# python caches from the video build scripts
__pycache__/
