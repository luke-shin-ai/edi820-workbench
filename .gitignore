node_modules/
dist/
out/*
!out/.gitkeep
.DS_Store
*.log

# Kiroween 2026 submission requirement: /.kiro MUST be committed.
# Never add .kiro, .kiro/specs, .kiro/steering or .kiro/hooks to this file.

# Internal planning / procedure records: they stay in the workspace, not in the
# public repository. They contain the Kiro user ID, Devpost account details and
# unpublished submission strategy — none of which belong in a public repo.
logs/
screenshots/
CONCEPT.md
strategy.md
procedure-status.md
rules-and-specs.md
credit-application-draft.md

# local scratch (tool runs, temporary reports)
.tmp/

# The video ships through the submission's YouTube link; the encoded file and the
# render intermediates stay out of the repository (they are reproducible with
# demo-video/build/README.md and are 100+ MB).
demo-video/*.mp4
demo-video/screenshots/
demo-video/build/plates/
demo-video/build/segs/
demo-video/build/tts/
demo-video/build/*.wav
demo-video/build/*.ass
demo-video/build/video_only.mp4

# python caches from the video build scripts
__pycache__/
