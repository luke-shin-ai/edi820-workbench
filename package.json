{
  "name": "edi820-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "「820」 - resurrection workbench for fixed-width EDI 820/823 payment files and COBOL copybooks (Kiroween 2026, Resurrection).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:pbt": "vitest run test/pbt",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.static.json --noEmit",
    "fixtures": "tsx scripts/gen-fixtures.mjs",
    "demo": "tsx scripts/demo-reconcile.mjs",
    "cli": "tsx src/cli/main.ts",
    "web": "tsx src/web/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "demo:cli": "tsx src/cli/main.ts demo",
    "evidence": "tsx src/cli/main.ts reconcile --copybook samples/copybooks/820.cpy --file samples/data/820-good.txt --bank samples/data/823-bank.txt --bank-copybook samples/copybooks/823.cpy --window 2026-11-18..2026-11-20 --out out/evidence",
    "verify:latest": "node scripts/verify-latest.mjs",
    "build:static": "tsx scripts/build-static.ts",
    "check:static": "python3 scripts/check-static.py",
    "check:claims": "node scripts/check-claims.mjs",
    "verify:public": "tsx scripts/verify-public-bai2.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
